{
  "name": "dwg-converter-service",
  "version": "1.0.0",
  "description": "DWG to DXF conversion API (Serverless, TypeScript)",
  "scripts": {
    "dev": "serverless offline start --httpPort 4000",
    "offline": "serverless offline start",
    "test": "jest --verbose",
    "lint": "eslint . --ext .ts",
    "build:layer": "./scripts/build-dwg-layer.sh",
    "deploy": "serverless deploy",
    "deploy:qa": "serverless deploy --stage qa",
    "deploy:prod": "serverless deploy --stage prod"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1147.0",
    "@aws-sdk/client-s3": "^3.823.0",
    "aws-multipart-parser": "^0.2.1",
    "dwg2dxf-converter": "1.0.4"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.12.7",
    "esbuild": "^0.25.4",
    "jest": "^29.7.0",
    "serverless": "^3.40.0",
    "serverless-esbuild": "^1.48.0",
    "serverless-offline": "^13.6.0",
    "ts-jest": "^29.3.4",
    "typescript": "^4.9.5"
  }
}
