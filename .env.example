# Local development overrides. Copy to .env and adjust.

# Converter binary for local runs. The deployed Lambda gets the layer's
# /opt/bin/dwg2dxf by default. Locally use the brew binary:
#   brew install libredwg
DWG_CONVERTER_PATH=/opt/homebrew/bin/dwg2dxf

# Destination bucket for converted DXF files (deployed environments).
# Leave unset locally: the API then returns the DXF in the local stash and
# reports the S3 skip as a warning.
DXF_S3_BUCKET=
DXF_S3_BUCKET_REGION=eu-west-1
